# ShiftFlex Environment Configuration Example
# Copy this file to .env or .env.local for local overrides
# DO NOT COMMIT PRIVATE KEYS OR SECRETS TO SOURCE CONTROL

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Base URL of ShiftFlex API Gateway (when backend is connected)
VITE_API_BASE_URL=https://api.shiftflex.com/v1

# Optional Feature Flags
VITE_ENABLE_RADAR_MOCK=true
VITE_ENABLE_ANALYTICS=false
